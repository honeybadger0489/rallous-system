# Tame difficulty stays global — honest.
summon fossil:triceratops ~8 ~ ~2 {CustomName:'{"text":"Temple Stegadon","color":"aqua"}',CustomNameVisible:1b,PersistenceRequired:1b,Tags:["rallous.temple_beast","rallous.lizardmen"]}
summon tameablebeasts:crested_gecko ~7 ~ ~-1 {CustomName:'{"text":"Temple Skink-beast","color":"aqua"}',CustomNameVisible:1b,PersistenceRequired:1b,Tags:["rallous.temple_beast","rallous.lizardmen"]}
summon turtle ~8 ~ ~1 {CustomName:'{"text":"Skink attendant","color":"aqua"}',CustomNameVisible:1b,PersistenceRequired:1b,Tags:["rallous.temple_beast","rallous.lizardmen"]}
