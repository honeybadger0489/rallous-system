# at the camp. Night done. Actor hears it.
execute if score #race rallous.session_race matches 1 run tellraw @a[tag=rallous.session.actor] [{"text":"<","color":"red","bold":true},{"selector":"@e[tag=rallous.lord,limit=1,sort=nearest]","color":"red","bold":true},{"text":"> ","color":"red","bold":true},{"text":"The road held. That is a kind of proof. A path may yet open.","color":"gold"}]
execute if score #race rallous.session_race matches 2 run tellraw @a[tag=rallous.session.actor] [{"text":"<","color":"dark_red","bold":true},{"selector":"@e[tag=rallous.lord,limit=1,sort=nearest]","color":"dark_red","bold":true},{"text":"> ","color":"dark_red","bold":true},{"text":"The night fed. You may walk our graves a while.","color":"gold"}]
execute if score #race rallous.session_race matches 3 run tellraw @a[tag=rallous.session.actor] [{"text":"<","color":"aqua","bold":true},{"selector":"@e[tag=rallous.lord,limit=1,sort=nearest]","color":"aqua","bold":true},{"text":"> ","color":"aqua","bold":true},{"text":"The plaque is satisfied. You are not daemon. For now.","color":"gold"}]
execute if score #race rallous.session_race matches 4 run tellraw @a[tag=rallous.session.actor] [{"text":"<","color":"dark_green","bold":true},{"selector":"@e[tag=rallous.lord,limit=1,sort=nearest]","color":"dark_green","bold":true},{"text":"> ","color":"dark_green","bold":true},{"text":"The herd smelled blood that was not yours. Stay, or run.","color":"gold"}]
execute if score #race rallous.session_race matches 5 run tellraw @a[tag=rallous.session.actor] [{"text":"<","color":"green","bold":true},{"selector":"@e[tag=rallous.lord,limit=1,sort=nearest]","color":"green","bold":true},{"text":"> ","color":"green","bold":true},{"text":"Good scrap. You can stay fer the next Waaagh.","color":"gold"}]
execute if score #race rallous.session_race matches 6 run tellraw @a[tag=rallous.session.actor] [{"text":"<","color":"gold","bold":true},{"selector":"@e[tag=rallous.lord,limit=1,sort=nearest]","color":"gold","bold":true},{"text":"> ","color":"gold","bold":true},{"text":"The grudge is marked paid. That will do for one night.","color":"white"}]
execute if score #race rallous.session_race matches 7 run tellraw @a[tag=rallous.session.actor] [{"text":"<","color":"light_purple","bold":true},{"selector":"@e[tag=rallous.lord,limit=1,sort=nearest]","color":"light_purple","bold":true},{"text":"> ","color":"light_purple","bold":true},{"text":"Alive-alive. The Council will hear you did not die. Yes-yes.","color":"gold"}]
execute if score #race rallous.session_race matches 8 run tellraw @a[tag=rallous.session.actor] [{"text":"<","color":"dark_red","bold":true},{"selector":"@e[tag=rallous.lord,limit=1,sort=nearest]","color":"dark_red","bold":true},{"text":"> ","color":"dark_red","bold":true},{"text":"Blood was given. Khorne cares not from whom. The night is yours.","color":"gold"}]
execute unless score #race rallous.session_race matches 1..8 run tellraw @a[tag=rallous.session.actor] {"text":"The night is spent. One village held, or one fight survived. That is enough.","color":"gold"}
