# Once. Exact Controls path. Recruits will not read this book; the player must open the GUI.
# SNBT quoted strings reject a bare \n — use \\n so the JSON page still gets a newline.
execute unless score @s rallous.rec.book matches 1 run give @s minecraft:written_book{title:"Crash-Camp Host",author:"Rallous Bind",pages:['{"text": "This book binds Recruits to the compiled camp you crashed next to.\\n\\nChat named that host. It is not Team 2.\\n\\nVillager Recruits 1.20.1 1.15.x has no /recruits create, /recruits hire, or /recruits ally that founds a banner."}','{"text": "Name the host (open this GUI):\\n\\nOptions → Controls → Hosts of the Old World → Open Elector / Waaagh / Under-Empire Screen (default U) → Found a Banner.\\n\\nType the crash-camp name from chat. Dye a cloth banner first. Emeralds are the founding cost."}','{"text": "Ally or war (open this GUI):\\n\\nSame U screen → Diplomacy → Ally (help / joined) or Enemy (hostile / war).\\n\\nAdmin-only after two banners exist:\\n/recruits admin diplomacyManager setRelations <A> <B> Ally|Neutral|Enemy\\n\\nThat does not create the crash-camp banner."}','{"text": "Hire (open this GUI):\\nRight-click a Levy → Levy for.\\n\\nOrders:\\nOptions → Controls → Hosts of the Old World → Open Host Command (default R).\\n\\nScores Recruits addons can read: rallous.rec.id / race / stance / rel. storage rallous_recruits_bind:contact holds the display name."}']} 1
execute unless score @s rallous.rec.book matches 1 run scoreboard players set @s rallous.rec.book 1
