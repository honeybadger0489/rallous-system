execute if score #race rallous.grow matches 1 run tellraw @a[distance=..48] {"text":"An Elector outpost hut goes up beside the picket. Not Altdorf. A levy house.","color":"red"}
execute if score #race rallous.grow matches 2 run tellraw @a[distance=..48] {"text":"A von Carstein hamlet shed rises. Graves remember builders.","color":"dark_red"}
execute if score #race rallous.grow matches 3 run tellraw @a[distance=..48] {"text":"A temple-city lean-to is stacked. The plaque does not call it a city.","color":"aqua"}
execute if score #race rallous.grow matches 4 run tellraw @a[distance=..48] {"text":"The herd throws a hide shelter. Stay if you fed it.","color":"dark_green"}
execute if score #race rallous.grow matches 5 run tellraw @a[distance=..48] {"text":"Boyz bang a hut together. Waaagh camp, still a camp.","color":"green"}
execute if score #race rallous.grow matches 6 run tellraw @a[distance=..48] {"text":"A hold outpost shed is set in stone. Not Karaz-a-Karak.","color":"gold"}
execute if score #race rallous.grow matches 7 run tellraw @a[distance=..48] {"text":"An Under-Empire scratch-warren. Yes-yes. Not Skavenblight.","color":"light_purple"}
execute if score #race rallous.grow matches 8 run tellraw @a[distance=..48] {"text":"A Bloodbound shrine lean-to. Skulls first, roof later.","color":"dark_red"}
