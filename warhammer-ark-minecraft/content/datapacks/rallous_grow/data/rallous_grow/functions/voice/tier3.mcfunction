execute if score #race rallous.grow matches 1 run tellraw @a[distance=..48] {"text":"Elector outpost hall. This is a provincial picket that grew — not a town hall.","color":"red"}
execute if score #race rallous.grow matches 2 run tellraw @a[distance=..48] {"text":"Von Carstein hamlet hall. The dead have a door.","color":"dark_red"}
execute if score #race rallous.grow matches 3 run tellraw @a[distance=..48] {"text":"Temple-city outpost hall. The plaque allows this much stone.","color":"aqua"}
execute if score #race rallous.grow matches 4 run tellraw @a[distance=..48] {"text":"Herd gathering hall. Bones on the posts.","color":"dark_green"}
execute if score #race rallous.grow matches 5 run tellraw @a[distance=..48] {"text":"Waaagh hall. Boss gets the big hut. Still not a city.","color":"green"}
execute if score #race rallous.grow matches 6 run tellraw @a[distance=..48] {"text":"Hold outpost hall. A grudge can be written here.","color":"gold"}
execute if score #race rallous.grow matches 7 run tellraw @a[distance=..48] {"text":"Under-Empire outpost hall. Council-scent, not the capital.","color":"light_purple"}
execute if score #race rallous.grow matches 8 run tellraw @a[distance=..48] {"text":"Bloodbound shrine hall. Khorne does not need a mayor.","color":"dark_red"}
