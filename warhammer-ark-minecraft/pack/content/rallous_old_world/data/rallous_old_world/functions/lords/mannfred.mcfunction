summon villager ~3 ~0 ~-2 {Tags:["rallous.lord","rallous.lord.mannfred"],CustomName:'{"text":"Mannfred von Carstein","color":"dark_red"}',CustomNameVisible:1b,PersistenceRequired:1b,Invulnerable:1b,VillagerData:{profession:"minecraft:cleric",level:5,type:"minecraft:swamp"},Offers:{Recipes:[{buy:{id:"minecraft:emerald",Count:1},sell:{id:"minecraft:written_book",Count:1,tag:{title:"Von Carstein Invitation",author:"Mannfred von Carstein",pages:['{"text": "I am Mannfred von Carstein. Sylvania is not a forest with a rumor. It is a county that voted for the grave."}','{"text": "The living bar their gates at dusk. The dead do not. Iron’s blood and death magics are how my court speaks. Malum is the slower occult — useful, not polite."}','{"text": "Job: walk my fens after dark. Kill what walks. Or bring me a living captain and kneel. Either is a province won."}','{"text": "Diplomacy: Ally me and Heartland towns will learn your name the wrong way. Enemy me and come at dawn with Recruits and a siege engine. Tribute is blood or bodies. Choose before the moon is up."}']}},maxUses:999,rewardExp:0b,xp:0}]}}
