# rallous_grow — Millénaire loop on the 7x7 crash camp.
# rallous.grow 0–3 (player + camp). rallous.grow_tier = structures already placed on the camp.
scoreboard objectives add rallous.grow dummy
scoreboard objectives add rallous.grow_tier dummy
scoreboard objectives add rallous.grow_sess dummy
scoreboard objectives add rallous.em_now dummy
scoreboard objectives add rallous.em_prev dummy
scoreboard objectives add rallous.em_init dummy
scoreboard objectives add rallous.traded minecraft.custom:minecraft.traded_with_villager
scoreboard objectives add rallous.session dummy
scoreboard objectives add rallous.session_kind dummy
scoreboard objectives add rallous.fac.race dummy
scoreboard objectives add rallous.fac.tier dummy
scoreboard objectives add rallous.race dummy
scoreboard players set #help rallous.session_kind 1
scoreboard players set #cap rallous.grow 3
